# Copia este archivo como .env y completa UNA de las dos claves.

# --- Opción A: Google Gemini (recomendado) ---
GEMINI_API_KEY=
# Modelo de edición con varias imágenes de referencia por solicitud.
# gemini-2.5-flash-image es rápido; gemini-3-pro-image-preview conserva mejor muchos objetos.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Opción B: OpenAI ---
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=high
# OPENAI_INPUT_FIDELITY=high   (déjalo vacío si tu modelo no lo admite)

# Si configuras las dos, elige cuál usar: gemini | openai
# (demo = modo de prueba que devuelve la foto sin editar).
# IMAGE_PROVIDER=gemini

# PORT=3000
